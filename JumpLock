local Players = game:GetService("Players")
local RS = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local lp = Players.LocalPlayer
local cam = workspace.CurrentCamera

local enabled = true
local SPIN_SPEED = 25   -- градусов за кадр (крути 10-45)
local WALL_DIST = 4     -- на каком расстоянии от стены включается

-- кнопка
local gui = Instance.new("ScreenGui")
gui.Name = "WallHopGui"
gui.ResetOnSpawn = false
pcall(function() gui.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
if not gui.Parent then gui.Parent = lp:WaitForChild("PlayerGui") end

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 150, 0, 40)
btn.Position = UDim2.new(0, 10, 0.5, 0)
btn.TextScaled = true
btn.Parent = gui

local function refresh()
    btn.Text = enabled and "WallHop: ВКЛ" or "WallHop: ВЫКЛ"
    btn.BackgroundColor3 = enabled and Color3.fromRGB(60, 170, 80) or Color3.fromRGB(170, 60, 60)
end
refresh()
btn.MouseButton1Click:Connect(function()
    enabled = not enabled
    refresh()
end)

local dirs = {
    Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0),
    Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
}

local function nearWall(root, char)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}
    for _, d in ipairs(dirs) do
        if workspace:Raycast(root.Position, d * WALL_DIST, params) then
            return true
        end
    end
    return false
end

RS.RenderStepped:Connect(function()
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    if not enabled then
        hum.AutoRotate = true
        return
    end

    hum.AutoRotate = false
    local holdingJump = UIS:IsKeyDown(Enum.KeyCode.Space) or hum.Jump
    local airborne = hum:GetState() == Enum.HumanoidStateType.Freefall
        or hum:GetState() == Enum.HumanoidStateType.Jumping

    if holdingJump and nearWall(root, char) then
        hum.Jump = true  -- авто-прыжок
        if airborne then
            root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(SPIN_SPEED), 0)  -- прокрут
        end
    else
        -- обычный шифт-лок: смотрим по камере
        local look = cam.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude > 0.01 then
            root.CFrame = CFrame.new(root.Position, root.Position + flat)
        end
    end
end)
