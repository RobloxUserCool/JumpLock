local Players = game:GetService("Players")
local RS = game:GetService("RunService")
local lp = Players.LocalPlayer
local cam = workspace.CurrentCamera

local enabled = true
local SPIN_PER_JUMP = 0
local spin = 0

local function hookChar(char)
    local hum = char:WaitForChild("Humanoid")
    hum.Jumping:Connect(function(active)
        if active and enabled then
            spin = spin + math.rad(SPIN_PER_JUMP)
        end
    end)
end
if lp.Character then task.spawn(hookChar, lp.Character) end
lp.CharacterAdded:Connect(hookChar)

-- кнопка
local gui = Instance.new("ScreenGui")
gui.Name = "JumpLockGui"
gui.ResetOnSpawn = false
pcall(function() gui.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
if not gui.Parent then gui.Parent = lp:WaitForChild("PlayerGui") end

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 130, 0, 40)
btn.Position = UDim2.new(0, 10, 0.5, 0)
btn.TextScaled = true
btn.Parent = gui

local function refresh()
    btn.Text = enabled and "JumpLock: ВКЛ" or "JumpLock: ВЫКЛ"
    btn.BackgroundColor3 = enabled and Color3.fromRGB(60, 170, 80) or Color3.fromRGB(170, 60, 60)
end
refresh()

btn.MouseButton1Click:Connect(function()
    enabled = not enabled
    spin = 0
    refresh()
end)

RS.RenderStepped:Connect(function()
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    if not enabled then
        hum.AutoRotate = true
        return
    end

    hum.AutoRotate = false
    local look = cam.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude > 0.01 then
        root.CFrame = CFrame.new(root.Position, root.Position + flat)
            * CFrame.Angles(0, spin, 0)
    end
end)
